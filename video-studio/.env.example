# =============================================
# VIDEO STUDIO TTS CONFIGURATION
# =============================================

# ----- TTS Provider Selection -----
# Choose which Text-to-Speech provider to use by default
# Options: f5 | edge | eleven | say
# 
# f5      = Your cloned voice using F5-TTS (best for personal brand)
# edge    = Microsoft Edge TTS (fast, free, multiple neural voices)
# eleven  = ElevenLabs API (high quality, requires API key)
# say     = macOS built-in voices (offline fallback)
#
# CLI flags override this: --f5, --edge, --eleven, --say
TTS_PROVIDER=f5

# ----- Edge TTS Settings -----
# Used when TTS_PROVIDER=edge or --edge flag
# Browse voices: https://speech.microsoft.com/portal/voicegallery
# Popular: en-US-GuyNeural, en-US-AriaNeural, en-US-JennyNeural
EDGE_TTS_VOICE=en-US-GuyNeural
EDGE_TTS_RATE=+0%        # Speed: -50% (slow) to +100% (fast)
EDGE_TTS_PITCH=+0%       # Pitch adjustment
EDGE_TTS_VOLUME=+0%      # Volume adjustment

# ----- F5-TTS Settings -----
# F5-TTS uses your cloned voice from input/voice/reference.wav
# No additional config needed - voice cloning is automatic
# Settings are in src/config.ts (speed, scenePauseMs, etc.)

# ----- ElevenLabs Settings -----
# Used when TTS_PROVIDER=eleven or --eleven flag
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_API_KEY=your_key_here

# ----- F5 Python Interpreter -----
# Path to Python 3.11-3.13 with F5-TTS installed
# Default: python3 (uses system Python from PATH)
# F5_PYTHON=/path/to/python3.12
