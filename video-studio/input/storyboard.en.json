      "motion": "kinetic",
      "narration": "Stop writing four lines of Python when one will do. Meet the list comprehension.",
      "sfx": { "cue": "riser", "offset": 0.1 },
      "text": {
        "kicker": "Python",
        "heading": "Loops in one line",
        "sub": "list comprehensions",
        "fill": "gradient"
